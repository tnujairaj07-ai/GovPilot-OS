{
  "name": "govpilot-os",
  "version": "1.0.0",
  "description": "GovPilot OS - Digital platform for government-startup innovation pilots",
  "main": "server/index.js",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"node server/index.js\" \"npm run dev --prefix web\"",
    "dev:server": "node server/index.js",
    "dev:web": "npm run dev --prefix web",
    "postinstall": "npm install --prefix web",
    "build": "npm install --prefix web && npm run build --prefix web",
    "start": "npm start --prefix web",
    "start:server": "node server/index.js",
    "init-db": "node server/db/init.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
